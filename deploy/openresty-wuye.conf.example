# Example for /etc/openresty/conf.d/wuye.conf or a compatible Nginx site directory.
# Replace the certificate paths before enabling this file.
server {
    listen 80;
    server_name luci-ona.site;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name luci-ona.site;
    ssl_certificate /etc/ssl/wuye/fullchain.pem;
    ssl_certificate_key /etc/ssl/wuye/privkey.pem;

    root /srv/wuye/h5;
    index index.html;

    location ^~ /app/ {
        proxy_pass http://127.0.0.1:8012;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /callComponent/ {
        proxy_pass http://127.0.0.1:8012;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
